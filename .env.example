# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Supabase — required production source of truth
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ForgeDeals session signing — required
SESSION_SECRET=

# Facebook
FACEBOOK_GROUP_URL=
# false opens a visible Chrome for manual login + 2FA; keep false for the initial connection
FACEBOOK_HEADLESS=false

# Application
APP_URL=http://localhost:3000
