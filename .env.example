# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Supabase — required production source of truth
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ForgeDeals session signing — required
SESSION_SECRET=

# Loja do Mecânico affiliate
# Defaults are the currently validated production affiliate identifiers.
AFFILIATE_ID=20889
AFFILIATE_GLOBAL_CODE=0S7w4Sy5S12oCKmeTo3Z3g==

# Facebook
FACEBOOK_GROUP_URL=
# false opens a visible browser for the initial manual login + 2FA.
# After authentication, the dedicated persistent profile is reused automatically.
FACEBOOK_HEADLESS=false
# Prefer the installed Chrome on the operator machine. Leave as chrome unless a controlled environment requires another Playwright channel.
FACEBOOK_BROWSER_CHANNEL=chrome

# Application
APP_URL=http://localhost:3000
